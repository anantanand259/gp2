# Copy this file to .env in C:\AI_ML\gp2 and replace the placeholders.
# .env is ignored by Git. Never commit real API keys.
GOOGLE_API_KEY=YOUR_GOOGLE_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
# Unconfigured providers are skipped. Keep independent providers for quota fallback.
LLM_PROVIDER_ORDER=openrouter,groq,gemini
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Maximum concurrent calls per provider in this Python process.
LLM_MAX_CONCURRENCY=2
NGROK_AUTH_TOKEN=YOUR_NGROK_AUTH_TOKEN
RAG_PORT=5000
# Keep disabled to avoid automatically retrying pending image/PDF extraction.
RAG_INGEST_ON_STARTUP=0
